---
import type { AnnualSnapshot, DesignIteration } from '../types/retrospective';

interface Props {
  iterations: DesignIteration[];
  snapshots: AnnualSnapshot[];
}

const { iterations, snapshots } = Astro.props;
const yearCount = snapshots.length;
const refreshCount = iterations.length;
---

<header class="hero-header">
  <div class="container">
    <div class="hero-top-meta">
      <span class="eyebrow">University of Illinois Urbana-Champaign · Archival UX &amp; IA Study</span>
      <span class="meta-pill">2000 – Present ({yearCount} Annual Captures)</span>
    </div>

    <h1 class="hero-title">
      College of Liberal Arts &amp; Sciences<br />
      <span class="hero-subtitle">Website History &amp; Navigation Retrospective</span>
    </h1>

    <p class="hero-lead">
      A 27-year chronological retrospective tracing how the College of LAS homepage evolved across three canonical
      domains and <strong>{refreshCount} major visual redesigns</strong>—and how its main navigation shifted from an
      administrative HTML directory to 100% persona-gated mega-menus, and finally to today’s
      <strong>Recruitment-First Information Architecture</strong>.
    </p>

    <div class="epoch-strip" role="region" aria-label="Canonical URL Epochs from oldest to newest">
      <div class="epoch-strip-label">Canonical URL Progression (Oldest → Newest)</div>
      <ol class="epoch-list">
        <li class="epoch-card">
          <a href="#iter-2000" class="epoch-link">
            <span class="epoch-step">Epoch 1 · 2000–Aug 2008</span>
            <span class="epoch-host mono">www.las.uiuc.edu</span>
            <span class="epoch-note">Early HTML tables through the periwinkle "Resources For" split-bar era (mirrored until 2013; 301 redirect in 2014).</span>
          </a>
        </li>
        <li class="epoch-arrow" aria-hidden="true">→</li>
        <li class="epoch-card">
          <a href="#iter-2008" class="epoch-link">
            <span class="epoch-step">Epoch 2 · Aug 2008–2018</span>
            <span class="epoch-host mono">www.las.illinois.edu</span>
            <span class="epoch-note">Campus rebrand to illinois.edu, ATLAS semantic CSS era, and Bootstrap 4-audience mega-menus.</span>
          </a>
        </li>
        <li class="epoch-arrow" aria-hidden="true">→</li>
        <li class="epoch-card epoch-card-current">
          <a href="#iter-2019" class="epoch-link">
            <span class="epoch-step">Epoch 3 · 2019–Present (Canonical)</span>
            <span class="epoch-host mono">las.illinois.edu</span>
            <span class="epoch-note">Bare-domain HTTPS cutover, Drupal 8–10 overhaul, and Illinois Web Theme (&lt;ilw-header&gt;) Recruitment-First IA.</span>
          </a>
        </li>
      </ol>
    </div>

    <div class="findings-grid" aria-label="Key longitudinal findings">
      <div class="finding-card">
        <div class="finding-stat">{refreshCount} Visual Eras</div>
        <p class="finding-body">
          Nine substantial visual layout overhauls between 2000 and 2025, backed by {yearCount} scrubbable desktop
          screencaps (1280×900) verified against Internet Archive captures.
        </p>
      </div>
      <div class="finding-card">
        <div class="finding-stat">4 Evergreen Anchors</div>
        <p class="finding-body">
          Only <em>About LAS</em>, <em>Departments &amp; Units</em>, <em>Alumni</em>, and <em>Make a Gift / Give</em>
          appeared in homepage navigation across all 9/9 eras—even <em>Majors</em> was hidden behind “Students” in 2001–2013.
        </p>
      </div>
      <div class="finding-card">
        <div class="finding-stat">90% → 13% Persona Gate</div>
        <p class="finding-body">
          Audience-gated links climbed from 14% (2000) to <strong>90%</strong> in 2016 when four personas owned the
          entire primary mega-menu, before dropping sharply in the 2019 Drupal overhaul.
        </p>
      </div>
      <div class="finding-card">
        <div class="finding-stat">Recruitment-First Pivot</div>
        <p class="finding-body">
          Modern LAS UX intentionally prioritizes prospective student recruitment (<em>Visit · Apply · Give</em>) and
          relocates internal campus audiences (<em>Faculty &amp; Staff</em>) out of primary nav to the footer.
        </p>
      </div>
    </div>
  </div>
</header>

<style>
  .hero-header {
    background: var(--bg-surface);
    border-bottom: 1px solid var(--border-light);
    padding: 3rem 0 2.5rem;
  }

  .hero-top-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.9rem;
  }

  .meta-pill {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--ink-secondary);
    background: var(--bg-subtle);
    border: 1px solid var(--border-light);
    padding: 0.25rem 0.7rem;
    border-radius: 999px;
  }

  .hero-title {
    margin: 0 0 1rem;
    font-size: clamp(2rem, 3.6vw, 3rem);
    line-height: 1.13;
    letter-spacing: -0.025em;
    color: var(--illini-navy);
  }

  .hero-subtitle {
    font-weight: 500;
    color: var(--ink-secondary);
    font-size: clamp(1.35rem, 2.3vw, 1.95rem);
  }

  .hero-lead {
    margin: 0 0 2rem;
    max-width: 78ch;
    font-size: 1.08rem;
    color: var(--ink-body);
  }

  .epoch-strip {
    background: var(--bg-page);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-lg);
    padding: 1.15rem 1.25rem;
    margin-bottom: 1.5rem;
  }

  .epoch-strip-label {
    font-size: 0.74rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--ink-secondary);
    margin-bottom: 0.75rem;
  }

  .epoch-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr auto 1fr auto 1fr;
    gap: 0.75rem;
    align-items: stretch;
  }

  .epoch-arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 1.2rem;
    color: var(--ink-muted);
  }

  .epoch-card {
    background: var(--bg-surface);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-md);
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }

  .epoch-card-current {
    border-left: 4px solid var(--illini-orange);
  }

  .epoch-card:hover {
    border-color: var(--illini-navy);
    box-shadow: var(--shadow-sm);
  }

  .epoch-link {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.85rem 1rem;
    text-decoration: none;
    color: inherit;
    height: 100%;
  }

  .epoch-step {
    font-size: 0.73rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--ink-secondary);
  }

  .epoch-host {
    font-size: 1.02rem;
    font-weight: 700;
    color: var(--illini-navy);
  }

  .epoch-note {
    font-size: 0.83rem;
    line-height: 1.45;
    color: var(--ink-secondary);
  }

  .findings-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
  }

  .finding-card {
    background: var(--bg-page);
    border: 1px solid var(--border-light);
    border-top: 3px solid var(--illini-navy);
    border-radius: var(--radius-md);
    padding: 1rem 1.1rem;
  }

  .finding-card:nth-child(3),
  .finding-card:nth-child(4) {
    border-top-color: var(--illini-orange);
  }

  .finding-stat {
    font-size: 1.05rem;
    font-weight: 750;
    color: var(--illini-navy);
    margin-bottom: 0.35rem;
  }

  .finding-body {
    margin: 0;
    font-size: 0.86rem;
    line-height: 1.5;
    color: var(--ink-secondary);
  }

  @media (max-width: 1024px) {
    .epoch-list {
      grid-template-columns: 1fr;
    }
    .epoch-arrow {
      display: none;
    }
    .findings-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .findings-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
