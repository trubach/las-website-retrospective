---
import type { DesignIteration, TaxonomyDataset } from '../types/retrospective';
import { buildConceptMatrix, countConceptPresence } from '../utils/retrospective-helpers';

interface Props {
  taxonomy: TaxonomyDataset;
  iterations: DesignIteration[];
}

const { taxonomy, iterations } = Astro.props;
const matrix = buildConceptMatrix(taxonomy, iterations);

const conceptsWithStats = taxonomy.concepts.map((concept) => {
  const counts = countConceptPresence(concept, iterations, matrix);
  const isEvergreen = counts.headerEras === iterations.length;
  const hasFooterDisplacement = counts.footerOnlyEras > 0;
  const isAudienceRelated =
    concept.defaultParadigm === 'audience' ||
    concept.id.startsWith('persona-') ||
    concept.id === 'alumni-engagement';
  const isRecruitmentRelated = concept.domainId === 'recruitment-admissions';
  return {
    ...concept,
    headerEras: counts.headerEras,
    footerOnlyEras: counts.footerOnlyEras,
    isEvergreen,
    hasFooterDisplacement,
    isAudienceRelated,
    isRecruitmentRelated,
  };
});

const domainMap = new Map(taxonomy.domains.map((d) => [d.id, d]));
---

<section id="continuity-matrix" class="synthesis-section" aria-labelledby="matrix-heading">
  <div class="container">
    <div class="section-header">
      <span class="eyebrow">Cross-Era Synthesis · Part 1</span>
      <h2 id="matrix-heading" class="section-heading">
        27-Year Navigation Continuity &amp; Structural Shift Matrix
      </h2>
      <p class="section-lead">
        Every navigation link across all {iterations.length} Design Iterations (2000–Present) normalized into{' '}
        <strong>{taxonomy.concepts.length} Canonical Navigation Concepts</strong> across {taxonomy.domains.length}{' '}
        domains—revealing which concepts endured in every era, how depth exploded with 2014’s mega-menus, and which
        zones carried each destination over time.
      </p>
    </div>

    <div class="commonalities-grid">
      <div class="synth-callout">
        <h3>Enduring Commonalities (2000–Present)</h3>
        <ul>
          <li>
            <strong>Four Evergreen Concepts (9/9 eras):</strong> <em>About &amp; Fast Facts</em>,{' '}
            <em>Departments &amp; Units</em>, <em>Alumni Relations</em>, and <em>Give / Make a Gift</em> appeared in
            homepage navigation across every single iteration since 2000 (whereas even <em>Majors &amp; Programs</em>{' '}
            disappeared behind the <em>“Students”</em> persona portal during the shallow-bar years of 2001–2013).
          </li>
          <li>
            <strong>Philanthropy’s Permanent Elevation:</strong> From <em>“Make A Gift”</em> (2000) to the white top
            pill (2005), orange hero CTA tab (2008), utility button (2016), and dual utility + primary placement
            (2021–2026), donor giving never left Level-1 visibility.
          </li>
        </ul>
      </div>
      <div class="synth-callout synth-callout-diff">
        <h3>Defining Structural Differences</h3>
        <ul>
          <li>
            <strong>Flat Hubs → Deep Mega-Menus:</strong> From 2000 to 2013 (outside a brief 2006–2007 hover-menu
            experiment), homepage nav stayed shallow (8–17 Level-1 links). In 2014, Level-2 links jumped to 55–62 items
            and remained deep through 2026.
          </li>
          <li>
            <strong>Units &amp; Research Mobility:</strong> <em>Departments &amp; Units</em> sat at Primary L1 from
            2000–2013, shifted to the Utility bar during the 2014–2018 audience mega-menu era, and nested under{' '}
            <em>About (L2)</em> from 2019 onward—while <em>Research</em> vanished from L1 between 2001 and 2018 before
            reclaiming its own top-level menu in 2019.
          </li>
        </ul>
      </div>
    </div>

    <div class="matrix-controls" role="region" aria-label="Filter continuity matrix">
      <div class="filter-pills" role="group" aria-label="Concept filter presets">
        <button type="button" class="filter-pill is-active" data-matrix-filter="all">
          All Concepts ({taxonomy.concepts.length})
        </button>
        <button type="button" class="filter-pill" data-matrix-filter="evergreen">
          Evergreen Core (9/9 Eras)
        </button>
        <button type="button" class="filter-pill" data-matrix-filter="audience">
          Audience &amp; Persona Shifts
        </button>
        <button type="button" class="filter-pill" data-matrix-filter="recruitment">
          Admissions &amp; Recruitment
        </button>
        <button type="button" class="filter-pill" data-matrix-filter="displaced">
          Displaced / Zone-Shifted
        </button>
      </div>

      <div class="domain-select-wrap">
        <label for="matrix-domain-select">Domain:</label>
        <select id="matrix-domain-select" data-matrix-domain>
          <option value="all">All {taxonomy.domains.length} Domains</option>
          {taxonomy.domains.map((d) => <option value={d.id}>{d.name}</option>)}
        </select>
      </div>
    </div>

    <div class="matrix-legend" aria-label="Cell zone and depth legend">
      <span class="legend-title">Cell Zone &amp; Hierarchy Key:</span>
      <span class="mcell-badge code-P1">P·L1</span> <span class="legend-txt">Primary L1</span>
      <span class="mcell-badge code-P2">P·L2</span> <span class="legend-txt">Primary L2</span>
      <span class="mcell-badge code-AUD">AUD·L1</span> <span class="legend-txt">Audience Bar L1</span>
      <span class="mcell-badge code-A2">AUD·L2</span> <span class="legend-txt">Audience Mega-Menu L2</span>
      <span class="mcell-badge code-UTL">UTL</span> <span class="legend-txt">Utility Header</span>
      <span class="mcell-badge code-SDB">SIDE</span> <span class="legend-txt">Sidebar</span>
      <span class="mcell-badge code-FTR">FOOTER</span> <span class="legend-txt">Displaced to Footer</span>
    </div>

    <div class="cell-inspector" id="matrix-cell-inspector" aria-live="polite">
      Click any cell in the matrix below to inspect the exact verbatim link labels, parent menu, and URL paths used in
      that Design Iteration.
    </div>

    <div class="matrix-table-scroll">
      <table class="matrix-table">
        <thead>
          <tr>
            <th scope="col" class="sticky-col">Canonical Concept</th>
            <th scope="col" class="eras-count-col" title="Number of header eras present">Eras</th>
            {
              iterations.map((it) => (
                <th scope="col" class="era-col">
                  <a href={`#${it.id}`} class="era-col-link">
                    <span class="era-yr">{it.debutYear}</span>
                    <span class="era-sub">{it.endYear ? `–${String(it.endYear).slice(2)}` : '+'}</span>
                  </a>
                </th>
              ))
            }
          </tr>
        </thead>
        <tbody>
          {
            conceptsWithStats.map((concept) => {
              const domain = domainMap.get(concept.domainId);
              return (
                <tr
                  data-concept-row
                  data-domain={concept.domainId}
                  data-evergreen={concept.isEvergreen ? '1' : '0'}
                  data-audience={concept.isAudienceRelated ? '1' : '0'}
                  data-recruitment={concept.isRecruitmentRelated ? '1' : '0'}
                  data-displaced={
                    concept.hasFooterDisplacement || (concept.headerEras >= 3 && !concept.isEvergreen) ? '1' : '0'
                  }
                >
                  <th scope="row" class="sticky-col concept-th">
                    <span class="concept-domain-kicker">{domain?.name}</span>
                    <span class="concept-name">{concept.name}</span>
                  </th>
                  <td class="eras-count-col">
                    <span class:list={['presence-pill', { 'presence-full': concept.isEvergreen }]}>
                      {concept.headerEras}/{iterations.length}
                    </span>
                  </td>
                  {iterations.map((it) => {
                    const cell = matrix[concept.id][it.id];
                    const detailPayload = {
                      conceptName: concept.name,
                      eraLabel: `${it.yearSpanLabel} (${it.title})`,
                      zoneSummary: cell.zoneSummary,
                      entries: cell.entries,
                    };
                    return (
                      <td class="matrix-td">
                        {cell.code === 'NONE' ? (
                          <span class="mcell-empty" aria-label={`${concept.shortName}: absent in ${it.debutYear}`}>
                            —
                          </span>
                        ) : (
                          <button
                            type="button"
                            class={`mcell-badge mcell-btn code-${cell.code}`}
                            data-cell-detail={JSON.stringify(detailPayload)}
                            title={`${concept.shortName} in ${it.debutYear} (${cell.zoneSummary}): ${cell.entries
                              .map((e) => (e.parentLabel ? `${e.parentLabel} → ${e.label}` : e.label))
                              .join('; ')}`}
                          >
                            {cell.badgeLabel}
                          </button>
                        )}
                      </td>
                    );
                  })}
                </tr>
              );
            })
          }
        </tbody>
      </table>
    </div>
  </div>
</section>

<script>
  const filterBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-matrix-filter]'));
  const domainSelect = document.querySelector<HTMLSelectElement>('[data-matrix-domain]');
  const rows = Array.from(document.querySelectorAll<HTMLTableRowElement>('[data-concept-row]'));
  const inspector = document.getElementById('matrix-cell-inspector');

  let activePreset = 'all';
  let activeDomain = 'all';

  function applyMatrixFilters() {
    for (const row of rows) {
      const domainOk = activeDomain === 'all' || row.dataset.domain === activeDomain;
      let presetOk = true;
      if (activePreset === 'evergreen') presetOk = row.dataset.evergreen === '1';
      else if (activePreset === 'audience') presetOk = row.dataset.audience === '1';
      else if (activePreset === 'recruitment') presetOk = row.dataset.recruitment === '1';
      else if (activePreset === 'displaced') presetOk = row.dataset.displaced === '1';
      row.hidden = !(domainOk && presetOk);
    }
  }

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      activePreset = btn.dataset.matrixFilter || 'all';
      filterBtns.forEach((b) => b.classList.toggle('is-active', b === btn));
      applyMatrixFilters();
    });
  });

  domainSelect?.addEventListener('change', () => {
    activeDomain = domainSelect.value;
    applyMatrixFilters();
  });

  document.querySelectorAll<HTMLButtonElement>('[data-cell-detail]').forEach((cellBtn) => {
    cellBtn.addEventListener('click', () => {
      document
        .querySelectorAll<HTMLButtonElement>('[data-cell-detail].is-selected')
        .forEach((b) => b.classList.remove('is-selected'));
      cellBtn.classList.add('is-selected');
      const raw = cellBtn.dataset.cellDetail;
      if (!raw || !inspector) return;
      const d = JSON.parse(raw);
      inspector.innerHTML = '';
      const header = document.createElement('div');
      header.className = 'inspector-head';
      const strong = document.createElement('strong');
      strong.textContent = `${d.conceptName} · ${d.eraLabel}`;
      const zoneSpan = document.createElement('span');
      zoneSpan.className = 'inspector-zone';
      zoneSpan.textContent = ` — ${d.zoneSummary}`;
      header.append(strong, zoneSpan);

      const list = document.createElement('div');
      list.className = 'inspector-items';
      for (const e of d.entries) {
        const chip = document.createElement('span');
        chip.className = 'inspector-chip';
        const pathTxt = e.parentLabel ? `${e.parentLabel} → "${e.label}"` : `"${e.label}"`;
        chip.textContent = `${pathTxt} [${e.zoneName} · ${e.href}]`;
        list.appendChild(chip);
      }
      inspector.append(header, list);
    });
  });
</script>

<style>
  .synthesis-section {
    padding: 3.25rem 0;
    background: var(--bg-surface);
    border-top: 1px solid var(--border-light);
    border-bottom: 1px solid var(--border-light);
    scroll-margin-top: 3.5rem;
  }

  .section-header {
    margin-bottom: 1.5rem;
  }

  .commonalities-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.15rem;
    margin-bottom: 1.5rem;
  }

  .synth-callout {
    background: var(--bg-page);
    border: 1px solid var(--border-light);
    border-top: 3px solid var(--illini-navy);
    border-radius: var(--radius-md);
    padding: 1.1rem 1.25rem;
  }

  .synth-callout-diff {
    border-top-color: var(--illini-orange);
  }

  .synth-callout h3 {
    margin: 0 0 0.55rem;
    font-size: 1rem;
    color: var(--illini-navy);
  }

  .synth-callout ul {
    margin: 0;
    padding-left: 1.15rem;
    font-size: 0.88rem;
    color: var(--ink-body);
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .matrix-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.85rem;
  }

  .filter-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .filter-pill {
    background: var(--bg-page);
    border: 1px solid var(--border-light);
    border-radius: 999px;
    padding: 0.32rem 0.78rem;
    font-size: 0.8rem;
    font-weight: 650;
    color: var(--ink-body);
    cursor: pointer;
  }

  .filter-pill:hover {
    border-color: var(--illini-navy);
  }

  .filter-pill.is-active {
    background: var(--illini-navy);
    color: #ffffff;
    border-color: var(--illini-navy);
  }

  .domain-select-wrap {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--ink-secondary);
  }

  .domain-select-wrap select {
    padding: 0.32rem 0.6rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-strong);
    background: #ffffff;
    color: var(--ink-body);
    font-size: 0.82rem;
  }

  .matrix-legend {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.77rem;
    color: var(--ink-secondary);
    margin-bottom: 0.8rem;
  }

  .legend-title {
    font-weight: 700;
    margin-right: 0.25rem;
  }

  .legend-txt {
    margin-right: 0.45rem;
  }

  .cell-inspector {
    background: var(--bg-page);
    border: 1px solid var(--border-light);
    border-left: 3px solid var(--illini-navy);
    border-radius: var(--radius-sm);
    padding: 0.65rem 0.9rem;
    margin-bottom: 0.9rem;
    font-size: 0.84rem;
    color: var(--ink-secondary);
  }

  :global(.inspector-head) {
    color: var(--illini-navy);
    margin-bottom: 0.35rem;
  }

  :global(.inspector-items) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  :global(.inspector-chip) {
    background: #ffffff;
    border: 1px solid var(--border-light);
    border-radius: 4px;
    padding: 0.16rem 0.5rem;
    font-size: 0.78rem;
    color: var(--ink-body);
    font-family: var(--font-mono);
  }

  .matrix-table-scroll {
    overflow-x: auto;
    border: 1px solid var(--border-light);
    border-radius: var(--radius-md);
    background: #ffffff;
  }

  .matrix-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.8rem;
  }

  .matrix-table th,
  .matrix-table td {
    border-bottom: 1px solid #ebeff5;
    padding: 0.5rem 0.45rem;
    text-align: center;
  }

  .matrix-table thead th {
    background: var(--bg-subtle);
    color: var(--illini-navy);
    font-weight: 750;
    border-bottom: 2px solid var(--border-light);
  }

  .sticky-col {
    position: sticky;
    left: 0;
    z-index: 2;
    background: #ffffff;
    text-align: left !important;
    min-width: 240px;
    max-width: 280px;
    padding-left: 0.85rem !important;
    border-right: 1px solid var(--border-light);
  }

  .matrix-table thead .sticky-col {
    background: var(--bg-subtle);
    z-index: 3;
  }

  .concept-domain-kicker {
    display: block;
    font-size: 0.66rem;
    font-weight: 650;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--ink-muted);
  }

  .concept-name {
    display: block;
    font-weight: 650;
    color: var(--ink-body);
    line-height: 1.3;
  }

  .era-col-link {
    text-decoration: none;
    color: var(--illini-navy);
    display: inline-flex;
    align-items: baseline;
  }

  .era-yr {
    font-weight: 750;
    font-size: 0.83rem;
  }

  .era-sub {
    font-size: 0.72rem;
    color: var(--ink-muted);
  }

  .presence-pill {
    display: inline-block;
    padding: 0.1rem 0.42rem;
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 700;
    background: var(--bg-subtle);
    color: var(--ink-secondary);
  }

  .presence-full {
    background: var(--illini-navy);
    color: #ffffff;
  }

  .mcell-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 54px;
    padding: 0.16rem 0.38rem;
    border-radius: 5px;
    font-size: 0.69rem;
    font-weight: 750;
    letter-spacing: 0.02em;
    border: 1px solid transparent;
  }

  .mcell-btn {
    cursor: pointer;
  }

  .mcell-btn.is-selected {
    outline: 2px solid var(--illini-orange);
    outline-offset: 1px;
  }

  .code-P1 {
    background: var(--illini-navy);
    color: #ffffff;
  }

  .code-P2 {
    background: var(--tag-topic-bg);
    color: var(--tag-topic-ink);
    border-color: var(--tag-topic-border);
  }

  .code-AUD {
    background: var(--illini-orange-tint);
    color: var(--illini-orange-ink);
    border-color: var(--illini-orange);
  }

  .code-A2 {
    background: #fff8f3;
    color: var(--tag-audience-ink);
    border-color: var(--tag-audience-border);
  }

  .code-UTL,
  .code-U2 {
    background: var(--tag-task-bg);
    color: var(--tag-task-ink);
    border-color: var(--tag-task-border);
  }

  .code-SDB {
    background: var(--bg-subtle);
    color: var(--ink-secondary);
    border-color: var(--border-strong);
  }

  .code-FTR {
    background: #f8f9fb;
    color: var(--ink-secondary);
    border: 1px dashed var(--border-strong);
  }

  .mcell-empty {
    color: #b7c1cf;
    font-size: 0.8rem;
  }

  @media (max-width: 900px) {
    .commonalities-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
